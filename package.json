{
  "name": "dsh-openai-subscription",
  "version": "0.2.0-rc.1",
  "description": "DSH ChatGPT subscription provider, usage windows and earned rate-limit resets",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lyts825/dsh-openai-subscription.git" },
  "homepage": "https://github.com/lyts825/dsh-openai-subscription#readme",
  "bugs": { "url": "https://github.com/lyts825/dsh-openai-subscription/issues" },
  "engines": { "node": ">=24.2" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml", "README.md", "CHANGELOG.md", "PROJECT_STATUS.md", "patches/", "desktop/README.zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.host.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "0.87.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@openai/codex": "0.162.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  }
}
